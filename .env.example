# SMTP (contact form)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Supabase (blog + admin dashboard) — Project Settings → API
# NEXT_PUBLIC_* values are inlined at build time, so they must be set when running `npm run build`.
NEXT_PUBLIC_SUPABASE_URL=https://nscawhaupnvbazbewzvw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret for the public blog API (/api/v1). Project Settings → API → service_role.
# Never prefix with NEXT_PUBLIC_ and never commit the real value. Read at runtime, so set it
# in the server's environment (cPanel → Setup Node.js App → Environment variables).
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin, used for absolute URLs in API responses and SEO metadata.
SITE_URL=https://www.vizionforge.com
